#!/usr/bin/env sh

set -eu

TOOL_HOME=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
PROJECT_DIR=$(pwd)
CONFIG_FILE=

usage() {
	cat <<'EOF'
Usage: idempiere-plugin-ci [global options] COMMAND [command arguments]

Global options:
  --project-dir DIR   Plugin repository to validate (default: current directory)
  --config FILE       Configuration file (default: PROJECT_DIR/plugin-ci.properties)
  -h, --help          Show this help

Commands:
  validate                              Run static repository and 2Pack validation
  validate-branch BRANCH SOURCE TARGET  Validate integration and release branch policy
  compile TARGET_PLATFORM_DIR           Compile production and test bundles
  validate-artifacts DIR QUALIFIER      Validate compiled bundle artifacts
  package-artifacts DIR OUT BRANCH NUM  Create immutable release artifacts
  validate-2pack-db                     Install, upgrade, and reinstall 2Packs in a disposable database
  help                                  Show this help
EOF
}

while [ "$#" -gt 0 ]; do
	case "$1" in
		--project-dir)
			[ "$#" -ge 2 ] || { echo 'Missing value for --project-dir' >&2; exit 2; }
			PROJECT_DIR=$2
			shift 2
			;;
		--config)
			[ "$#" -ge 2 ] || { echo 'Missing value for --config' >&2; exit 2; }
			CONFIG_FILE=$2
			shift 2
			;;
		-h|--help)
			usage
			exit 0
			;;
		*) break ;;
	esac
done

[ "$#" -gt 0 ] || { usage >&2; exit 2; }
PROJECT_DIR=$(CDPATH= cd -- "$PROJECT_DIR" && pwd)
CONFIG_FILE=${CONFIG_FILE:-$PROJECT_DIR/plugin-ci.properties}
case "$CONFIG_FILE" in
	/*) ;;
	*) CONFIG_FILE="$PROJECT_DIR/$CONFIG_FILE" ;;
esac
[ -f "$CONFIG_FILE" ] || { echo "Configuration file not found: $CONFIG_FILE" >&2; exit 2; }

export PLUGIN_PROJECT_DIR=$PROJECT_DIR
export PLUGIN_CONFIG_FILE=$CONFIG_FILE

COMMAND=$1
shift
case "$COMMAND" in
	validate) exec "$TOOL_HOME/libexec/validate-plugin.sh" "$@" ;;
	validate-branch) exec "$TOOL_HOME/libexec/validate-branch.sh" "$@" ;;
	compile) exec "$TOOL_HOME/libexec/compile.sh" "$@" ;;
	validate-artifacts) exec "$TOOL_HOME/libexec/validate-artifacts.sh" "$@" ;;
	package-artifacts) exec "$TOOL_HOME/libexec/package-artifacts.sh" "$@" ;;
	validate-2pack-db) exec "$TOOL_HOME/libexec/validate-2pack-db.sh" "$@" ;;
	help) usage ;;
	*) echo "Unknown command: $COMMAND" >&2; usage >&2; exit 2 ;;
esac
